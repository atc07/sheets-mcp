{
  "name": "@sheetsmcp/server",
  "version": "1.3.3",
  "description": "Free, open-source MCP server for Google Sheets in Claude Desktop and Claude Code.",
  "scripts": {
    "build": "tsc",
    "auth": "node dist/index.js auth",
    "start": "node dist/index.js",
    "test:e2e": "node scripts/e2e.mjs",
    "deploy:site": "node scripts/deploy-site.mjs \"$(gcloud auth print-access-token)\" site sheets-mcp-k8ajul",
    "accounts": "node dist/index.js accounts",
    "pack:extension": "node scripts/pack-extension.mjs",
    "render:showcase": "node scripts/render-showcase.mjs",
    "prepublishOnly": "npm run build && node -e \"require('fs').accessSync('oauth-client.json')\""
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@googleapis/sheets": "^18.0.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "google-auth-library": "^11.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "bin": {
    "sheetsmcp": "dist/index.js"
  },
  "homepage": "https://sheetsmcp.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atc07/sheets-mcp.git"
  },
  "bugs": "https://github.com/atc07/sheets-mcp/issues",
  "mcpName": "io.github.atc07/sheets-mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "google-sheets",
    "spreadsheets"
  ],
  "files": [
    "dist",
    "oauth-client.json"
  ],
  "engines": {
    "node": ">=18"
  }
}
